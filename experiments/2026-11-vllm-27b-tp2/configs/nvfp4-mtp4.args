# The source's published recipe (vLLM v0.32.0): fp8-mtp4.args with --kv-cache-dtype nvfp4 and --gpu_memory_utilization 0.94
# (source: KV pool 474,032 tokens, 1.81x at 262,144; its NVFP4 tables were measured on nightly v0.32.0rc1.dev100).
local/vllm-openai:v0.32.0
NCCL_P2P_DISABLE=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_FLASHINFER_WORKSPACE_BUFFER_SIZE=67108864
--served-model-name
bench
--tensor-parallel-size
2
--no-enable-flashinfer-autotune
--disable_custom_all_reduce
--load-format
ipc_cache
--trust-remote-code
--kv-cache-dtype
nvfp4
--max-model-len
262144
--max-num-seqs
2
--compilation-config
{"cudagraph_mode": "PIECEWISE"}
--mamba-cache-dtype
bfloat16
--mamba-ssm-cache-dtype
bfloat16
--gpu_memory_utilization
0.94
--max-num-batched-tokens
4096
--enable-prefix-caching
--enable-chunked-prefill
--limit-mm-per-prompt
{"video": 0}
--mm-processor-kwargs
{"max_pixels": 1000000}
--speculative-config
{"method": "mtp", "num_speculative_tokens": 4}
--reasoning-parser
qwen3
--tool-call-parser
qwen3_xml
--enable-auto-tool-choice
--default-chat-template-kwargs
{"preserve_thinking": true}
