# --pipeline-parallel-size 2, --max-num-seqs 4, 39 / 25 layers on the stages, and --max-model-len 196608.
# 262144 does not fit: with 39 / 25 the first stage has 2.51 GiB of KV memory, 3.11 GiB are needed (vLLM: at most 206,048 tokens).
local/vllm-openai:v0.32.0
NCCL_P2P_DISABLE=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_FLASHINFER_WORKSPACE_BUFFER_SIZE=67108864
VLLM_PP_LAYER_PARTITION=39,25
--served-model-name
bench
--pipeline-parallel-size
2
--no-enable-flashinfer-autotune
--disable_custom_all_reduce
--load-format
ipc_cache
--trust-remote-code
--kv-cache-dtype
nvfp4
--max-model-len
196608
--max-num-seqs
4
--compilation-config
{"cudagraph_mode": "PIECEWISE"}
--mamba-cache-dtype
bfloat16
--mamba-ssm-cache-dtype
bfloat16
--gpu_memory_utilization
0.94
--max-num-batched-tokens
4096
--enable-prefix-caching
--enable-chunked-prefill
--limit-mm-per-prompt
{"video": 0}
--mm-processor-kwargs
{"max_pixels": 1000000}
--speculative-config
{"method": "mtp", "num_speculative_tokens": 4}
--reasoning-parser
qwen3
--tool-call-parser
qwen3_xml
--enable-auto-tool-choice
--default-chat-template-kwargs
{"preserve_thinking": true}
