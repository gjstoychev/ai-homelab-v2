# fp8-mtp4.args on the matched checkpoint (nvidia/Qwen3.8-27B-NVFP4 482ca0f3, MODEL_DIR=~/models/qwen3.8-27b-nvidia-nvfp4;
# step 16). Three changes, because the source's settings do not run on this checkpoint (journal 16): --max-model-len 180000
# (at 262144 the KV check refuses at every utilization up to the 0.975 that still starts), --gpu_memory_utilization 0.93
# and VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0 (at 0.95 without the estimate the first request runs out of memory,
# 114 MiB asked with 105 MiB free). KV budget 3.33 GiB, the same as 0.95 with the estimate on; that simpler pair was not run.
# Changes: --served-model-name bench (the shared clients' name), no --api-key.
local/vllm-openai:v0.30.0
NCCL_P2P_DISABLE=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_FLASHINFER_WORKSPACE_BUFFER_SIZE=67108864
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
--served-model-name
bench
--tensor-parallel-size
2
--no-enable-flashinfer-autotune
--disable_custom_all_reduce
--load-format
ipc_cache
--trust-remote-code
--kv-cache-dtype
fp8
--max-model-len
180000
--max-num-seqs
2
--compilation-config
{"cudagraph_mode": "PIECEWISE"}
--mamba-cache-dtype
bfloat16
--mamba-ssm-cache-dtype
bfloat16
--gpu_memory_utilization
0.93
--max-num-batched-tokens
4096
--enable-prefix-caching
--enable-chunked-prefill
--limit-mm-per-prompt
{"video": 0}
--mm-processor-kwargs
{"max_pixels": 1000000}
--speculative-config
{"method": "mtp", "num_speculative_tokens": 4}
--reasoning-parser
qwen3
--tool-call-parser
qwen3_xml
--enable-auto-tool-choice
--default-chat-template-kwargs
{"preserve_thinking": true}
